rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 팝업: 누구나 읽기 가능, 인증된 사용자만 쓰기
    match /popups/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // 배너: 누구나 읽기 가능, 인증된 사용자만 쓰기
    match /banners/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // 뉴스: 누구나 읽기 가능, 인증된 사용자만 쓰기
    match /news/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── AI 평가 패키지 (v2 — 에이전트 묶음) ──
    // 읽기: 로그인 사용자 누구나 (/new 플로우에서 패키지 선택용)
    // 쓰기: 클라이언트 write 차단 — /api/ai-evaluation/packages (Admin SDK) 경유
    match /evaluationPackages/{packageId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // v1 레거시 컬렉션 (점진 제거 — 쓰기 차단, 읽기만 허용)
    match /evaluationPrompts/{promptId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── AI 평가 결과 ──
    // 읽기: 생성자 본인만 (관리자는 서버 API 경유로 전체 접근)
    // 쓰기: 클라이언트 write 전면 차단 — Admin SDK only
    match /evaluations/{evalId} {
      allow read: if request.auth != null
                  && resource.data.createdBy == request.auth.uid;
      allow write: if false;

      // 챗 로그: 평가 소유자만 읽기 가능, 쓰기는 서버에서만
      match /chats/{chatId} {
        allow read: if request.auth != null
                    && get(/databases/$(database)/documents/evaluations/$(evalId)).data.createdBy == request.auth.uid;
        allow write: if false;
      }

      // 원본 추출 텍스트 등 artifacts
      match /artifacts/{artifactId} {
        allow read: if request.auth != null
                    && get(/databases/$(database)/documents/evaluations/$(evalId)).data.createdBy == request.auth.uid;
        allow write: if false;
      }
    }
  }
}
